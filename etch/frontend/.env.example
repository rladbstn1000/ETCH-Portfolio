# cp .env.example .env.local
VITE_API_BASE_URL=/api/v1
LOCAL_API_TARGET=http://localhost:18476
# 아래 기능은 해당 백엔드/외부 설정 준비 후에만 true로 변경한다.
VITE_ENABLE_CHAT=false
VITE_ENABLE_RECOMMENDATIONS=false
VITE_ENABLE_UPLOADS=false
VITE_ENABLE_OAUTH=false
VITE_CHAT_API_BASE_URL=/api/chat
LOCAL_CHAT_TARGET=http://localhost:18081
VITE_OAUTH_URL=/oauth2/authorization/google
