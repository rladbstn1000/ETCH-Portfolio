FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY etch/frontend/package*.json ./
RUN npm ci
COPY etch/frontend/ ./
ARG VITE_DEMO_MODE=false
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
ENV VITE_ENABLE_CHAT=false VITE_ENABLE_RECOMMENDATIONS=false VITE_ENABLE_UPLOADS=false VITE_ENABLE_OAUTH=false
RUN npm run build

FROM nginx:1.27-alpine
COPY local/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
# Bundle analyzer output is a build aid, not a demo route.
RUN rm -f /usr/share/nginx/html/stats.html
