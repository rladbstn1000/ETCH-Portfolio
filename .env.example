# 실제 자격증명 없음. scripts/local-init.sh가 로컬 전용 임의 값을 생성합니다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SPRING_JWT_SECRET=
MYSQL_PORT=13476
REDIS_PORT=16476
ES_PORT=19476
BACKEND_PORT=18476
FRONTEND_PORT=5178
LOGSTASH_API_PORT=19676
SYNC_FETCH_SIZE=50
SYNC_OVERLAP_SECONDS=120
LOGSTASH_SCHEDULE="*/10 * * * * * UTC"

# 다른 검증 환경은 ETCH_ENV_FILE로 파일을 선택하고 아래 값을 분리합니다.
ETCH_COMPOSE_PROJECT=etch-submission
ETCH_COMPOSE_OVERRIDE=
ETCH_STATE_DIR=.local
PREVIEW_PORT=5188
VITE_DEMO_MODE=false
